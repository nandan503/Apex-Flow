#!/usr/bin/env bash
# commit-msg hook — enforces Conventional Commits format.
# Install: cp .git-hooks/commit-msg .git/hooks/commit-msg && chmod +x .git/hooks/commit-msg
# Or run: bash scripts/install-hooks.sh

COMMIT_MSG_FILE="$1"
COMMIT_MSG=$(cat "$COMMIT_MSG_FILE")

# Allow merge commits, revert commits, and fixup commits through without validation.
if echo "$COMMIT_MSG" | grep -qE '^(Merge |Revert |fixup! |squash! )'; then
  exit 0
fi

# Conventional Commits pattern:
# <type>(<optional scope>): <description>
# Types: feat|fix|security|chore|docs|refactor|test|perf|ci|build
PATTERN='^(feat|fix|security|chore|docs|refactor|test|perf|ci|build)(\([a-z0-9/_-]+\))?: .{1,72}$'

SUBJECT=$(echo "$COMMIT_MSG" | head -1)

if ! echo "$SUBJECT" | grep -qE "$PATTERN"; then
  echo ""
  echo "❌ Commit message does not follow Conventional Commits format."
  echo ""
  echo "   Expected: <type>(<scope>): <description>"
  echo "   Got:      $SUBJECT"
  echo ""
  echo "   Valid types: feat | fix | security | chore | docs | refactor | test | perf | ci | build"
  echo ""
  echo "   Examples:"
  echo "     feat(shipments): add bulk status update endpoint"
  echo "     fix(auth): prevent session fixation on login"
  echo "     security(otp): upgrade to 6-digit CSPRNG with lockout"
  echo "     chore(deps): upgrade flask-limiter to 3.5.0"
  echo ""
  echo "   See docs/CONTRIBUTING.md §Commit Message Standards"
  echo ""
  exit 1
fi

# Warn (but don't block) if subject line exceeds 72 characters.
SUBJECT_LEN=${#SUBJECT}
if [ "$SUBJECT_LEN" -gt 72 ]; then
  echo "⚠️  Commit subject is $SUBJECT_LEN characters (recommended max: 72)."
  echo "    Consider shortening: $SUBJECT"
fi

exit 0
