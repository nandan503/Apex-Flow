# Configuration template only. Supply values through a secret manager/environment.
# Missing values FAIL startup, including in development. Do not commit real values.
APP_ENV=production
SECRET_KEY=
# PostgreSQL runtime role must be apex_app, NOINHERIT and NOBYPASSRLS, never owner.
# Production URI must explicitly include sslmode=verify-full. Install its trusted CA.
DATABASE_URL=
# Fernet key for encrypted OTP outbox payloads. Keep separate from the DB/backups.
OUTBOX_ENCRYPTION_KEY=
# Comma-separated generated secrets, newest first. Retain old keys for replay.
IDEMPOTENCY_HASH_KEYS=
# Exact cross-origin browser origins allowed to call this API. Same-origin
# requests (Origin == the serving origin, e.g. the site behind Cloudflare)
# are always accepted and do NOT need to be listed here. List an origin here
# ONLY if a genuinely separate frontend origin must call this API cross-origin.
# Never use wildcards; never reflect client-supplied Origin values.
# Canonical production topology (apex.viability.in -> Cloudflare -> provider):
# the same origin serves page and API, so set it to the canonical origin anyway
# as explicit documentation of the deployment, e.g. ALLOWED_ORIGINS=https://apex.viability.in
ALLOWED_ORIGINS=
# Optional HTTPS idempotent consumer. Without it, OTP events stay queued.
OUTBOX_DELIVERY_URL=
OUTBOX_API_TOKEN=
# REQUIRED=1 for the canonical production topology (apex.viability.in ->
# Cloudflare -> provider ingress that overwrites X-Forwarded-For/Proto and
# blocks direct origin access). ProxyFix restores https scheme + rightmost
# forwarding values; without it an https Origin is not recognized as
# same-origin and the request must be covered by ALLOWED_ORIGINS instead.
TRUST_PROXY=0
PORT=5050
WEB_CONCURRENCY=2
# MIGRATION_DATABASE_URL is ONLY supplied to an isolated migration/control-plane job.
# It must never be present in the web or outbox worker environment.
