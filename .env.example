# ============================================================
#  APEX FLOW — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ============================================================

# --- REQUIRED IN PRODUCTION ---

# Flask session signing key. Generate with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_secret_key_in_production

# Set to 'production' to enable all security hardening
FLASK_ENV=production


# --- DATABASE ---

# Leave empty to use SQLite (dev only).
# Set to your PostgreSQL connection string for production.
# DATABASE_URL=postgresql://user:password@hostname:5432/apexflow_db


# --- RATE LIMITING ---

# Leave empty for in-memory (single-instance).
# Set to Redis URL for multi-instance / production deployments.
# REDIS_URL=redis://localhost:6379

# Trust X-Forwarded-* from the edge proxy (Render/Railway/nginx). Never enable
# if the app is reachable directly without a proxy that overwrites those headers.
TRUST_PROXY=0

# Optional override for the SQLite file (tests / local).
# DATABASE_PATH=/tmp/apexflow.db


# --- CORS ---

# Comma-separated list of allowed frontend origins.
# Must match your deployed frontend URL exactly.
ALLOWED_ORIGINS=https://your-app.onrender.com,https://apex-flow.example.com


# --- SEED USER PASSWORDS (set before first run on a fresh DB) ---
# These passwords are used when initializing the database for the first time.
# Change them immediately after first deployment.

SEED_ADMIN_PASSWORD=change_this_admin_password
SEED_MANAGER_PASSWORD=change_this_manager_password
SEED_DRIVER_PASSWORD=change_this_driver_password
SEED_CUSTOMER_PASSWORD=change_this_customer_password


# --- SERVER ---
HOST=0.0.0.0
PORT=5050
